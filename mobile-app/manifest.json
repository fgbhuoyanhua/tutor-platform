{
  "name": "家教预约平台",
  "appid": "",
  "description": "大学生家教服务预约平台 - 移动端（uni-app x）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "uni-app-x": {
    "compilerVersion": "5.24",

// 后端地址：真机/模拟器调本机后端时用局域网 IP（IP 会变，测试前先 ipconfig 确认）
// 当前本机无线 IP：192.168.1.7
const BASE_URL = 'http://192.168.1.7:8080/api'
const TOKEN_KEY = 'tutor_platform_token'

function getToken(): string {
  const v = uni.getStorageSync(TOKEN_KEY)
  return v == null || v == '' ? '' : (v as string)
}

function toJsonData(d: any | null): UTSJSONObject | null {
  if (d == null) return null
  // 已经是 UTSJSONObject：直接透传，不要强转成 Map（会抛
  // "UTSJSONObject cannot be cast to io.dcloud.uts.Map"）
  if (d instanceof UTSJSONObject) {
    return d as UTSJSONObject
  }
  const obj = new UTSJSONObject()
  if (d instanceof Map) {
    (d as Map<string, any>).forEach((v: any, k: string) => {
      obj.set(k, v)
    })
  }
  return obj
}

export function request(
  method: string,
  url: string,
  data: any | null
): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>((resolve, reject) => {
    const header = new UTSJSONObject()
    header.set('Content-Type', 'application/json')
    const token = getToken()
    if (token != '') {
      header.set('Authorization', 'Bearer ' + token)
    }
    uni.request({
      url: BASE_URL + url,
      method: method,
      data: toJsonData(data),
      header: header,
      timeout: 10000,
      success: (res) => {
        const raw = res.data
        if (raw == null) {
          reject(new Error('响应为空'))
          return
        }
        let body: UTSJSONObject | null = null
        if (typeof raw == 'string') {
          try {
            body = JSON.parse(raw as string) as UTSJSONObject | null
          } catch (e) {
            reject(new Error('JSON解析失败'))
            return
          }
        } else {
          body = raw as UTSJSONObject | null
        }
        if (body == null) {
          reject(new Error('响应格式错误'))
          return
        }
        const code = body['code'] as number
        if (code == 200) {
          // 注意：不能直接写 `const d = body['data']`，UTS 会把 d 推断成
          // UTSJSONObject，后端返回数字/数组时会抛类型转换异常。
          // 这里按 any 取出后分情况处理，每种情况单独 resolve，避免对
          // 已声明为 UTSJSONObject 的变量重新赋 any 值（同样会触发强转）。
          try {
            const dAny: any | null = body['data']
            if (dAny == null) {
              resolve(new UTSJSONObject())
            } else if (Array.isArray(dAny)) {
              const w = new UTSJSONObject()
              w.set('list', dAny as any)
              resolve(w)
            } else if (typeof dAny == 'object') {
              resolve(dAny as UTSJSONObject)
            } else {
              // 数字/字符串/布尔等原始值
              const w = new UTSJSONObject()
              w.set('list', dAny as any)
              w.set('data', dAny as any)
              resolve(w)
            }
          } catch (e) {
            // 兜底：类型判断失败也不影响业务层流程
            resolve(new UTSJSONObject())
          }
        } else {
          const msg = body['message'] as string
          reject(new Error(msg))
        }
      },
      fail: (err) => {
        reject(new Error('网络异常: ' + err.errMsg))
      }
    })
  })
}

export function get(url: string, query: Map<string, any> | null): Promise<UTSJSONObject> {
  let full = url
  if (query != null) {
    const parts: string[] = []
    query.forEach((v: any, k: string) => {
      const vs = '' + v
      parts.push(k + '=' + encodeURIComponent(vs))
    })
    if (parts.length > 0) {
      full = url + '?' + parts.join('&')
    }
  }
  return request('GET', full, null)
}

export function post(url: string, data: UTSJSONObject | Map<string, any>): Promise<UTSJSONObject> {
  return request('POST', url, data)
}

export function put(url: string, data: UTSJSONObject | Map<string, any>): Promise<UTSJSONObject> {
  return request('PUT', url, data)
}

export function del(url: string): Promise<UTSJSONObject> {
  return request('DELETE', url, null)
}

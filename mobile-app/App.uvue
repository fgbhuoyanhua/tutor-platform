<script>
import { login } from './api/auth'
import { setToken, setUser, getToken } from './utils/storage'

export default {
  onLaunch() {
    console.log('家教预约平台移动端启动')
    // 开发期自动登录 student01：统一走 api/auth 封装，地址只在 utils/request.uts 里改一处
    const existing = getToken()
    if (existing == '') {
      login('student01', '123456').then((res) => {
        setToken(res['token'] as string)
        setUser(res)
        console.log('自动登录成功')
      }).catch((e) => {
        console.log('自动登录失败：请检查 utils/request.uts 里的 BASE_URL 是否为本机当前 IP')
      })
    }
  }
}
</script>

<style>
/* 全局基础样式：只放所有页面都会用到的 */
.page {
  background-color: #f5f7fa;
  /* 不要写 height / min-height / overflow: hidden，否则会破坏页面原生滚动 */
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
}

.btn-primary {
  background-color: #4f6ef7;
  color: #ffffff;
  border-radius: 12rpx;
}
</style>

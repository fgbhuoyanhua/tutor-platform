<script>
export default {
  async onLaunch() {
    console.log('家教预约平台移动端启动')
    // 开发期自动登录 student01
    const existing = uni.getStorageSync('tutor_platform_token')
    if (!existing) {
      try {
        const res = await uni.request({
          url: 'http://10.84.64.128:8080/api/auth/login',
          method: 'POST',
          header: { 'Content-Type': 'application/json' },
          data: { username: 'student01', password: '123456' }
        })
        const body = res.data as any
        if (body.code == 200) {
          uni.setStorageSync('tutor_platform_token', body.data.token)
          uni.setStorageSync('tutor_platform_user', body.data.user)
          console.log('自动登录成功')
        }
      } catch (e) {
        console.log('自动登录失败', e)
      }
    }
  }
}
</script>

<style>
/* 全局基础样式：只放所有页面都会用到的 */
.page {
  background-color: #f5f7fa;
  /* 不要写 height / min-height / overflow: hidden，否则会破坏页面原生滚动 */
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
}

.btn-primary {
  background-color: #4f6ef7;
  color: #ffffff;
  border-radius: 12rpx;
}
</style>
export const TIME_SLOTS: string[] = [
  '08:00-10:00',
  '09:00-11:00',
  '10:00-12:00',
  '14:00-16:00',
  '15:00-17:00',
  '16:00-18:00',
  '19:00-21:00'
]

// 金额格式化：与 Web 端 frontend-common/src/utils/format.ts 的 formatPrice 保持一致
export function formatPrice(p: number): string {
  return '¥' + p.toFixed(2)
}

// 订单状态文案：与后端 OrderDomain.statusText 一致
export function orderStatusLabel(status: number): string {
  if (status == 0) return '待确认'
  if (status == 1) return '已预约'
  if (status == 2) return '授课中'
  if (status == 3) return '已完成'
  if (status == 4) return '已取消'
  if (status == 5) return '已拒绝'
  return '未知'
}

// 角色文案
export function ROLE_LABELS_FN(role: number): string {
  if (role == 1) return '学生'
  if (role == 2) return '老师'
  if (role == 3) return '管理员'
  return '未知'
}

// 家教信息状态文案
export function TUTOR_STATUS_FN(status: number): string {
  if (status == 0) return '待审核'
  if (status == 1) return '已上架'
  if (status == 2) return '已下架'
  if (status == 3) return '未通过'
  return '未知'
}

// 消息类型文案
export function MESSAGE_TYPE_FN(type: number): string {
  if (type == 1) return '预约'
  if (type == 2) return '订单'
  if (type == 3) return '系统'
  if (type == 4) return '私信'
  return '未知'
}

  font-size: 28rpx;
  font-weight: 600;
  color: #1a1b1c;
  margin-bottom: 20rpx;
}
.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.value {
  flex: 1;
  font-size: 28rpx;
  color: #1a1b1c;
}
.input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.btn-primary {
  margin-top: 20rpx;
  background: #4f6ef7;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}
.btn-logout {
  margin: 40rpx 20rpx;
  background: #fff;

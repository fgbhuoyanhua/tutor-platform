  font-size: 32rpx;
  font-weight: 600;
  color: #1a1b1c;
}
.user-role {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}
.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.menu-text {
  font-size: 30rpx;
  color: #1a1b1c;
}
.menu-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}

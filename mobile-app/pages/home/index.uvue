  font-size: 36rpx;
  font-weight: 600;
  color: #1a1b1c;
  padding: 20rpx;
}
.filter {
  background: #ffffff;
  padding: 20rpx 0;
}
.fav-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-top-width: 1px;
  border-top-color: #f0f2f5;
}

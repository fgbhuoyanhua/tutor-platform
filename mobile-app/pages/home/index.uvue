  font-size: 26rpx;
  color: #606266;
}
.filter-inner {
  display: flex;
    flex-direction: row;
  padding: 0 20rpx;
}
.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #f0f2f5;
  color: #606266;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.filter-item.active {
  background: #1f2d3d;
  color: #ffffff;
}
.tutor-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
}
.tutor-head {
  display: flex;
    flex-direction: row;
  align-items: center;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #eef2ff;
}
.avatar-text {
  text-align: center;

  flex: 1;
  background: #f5f7fa;
}
.workbench {
  padding: 20rpx;
}
.welcome {
  padding: 30rpx;
  background: linear-gradient(135deg, #4f6ef7, #6b8afd);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

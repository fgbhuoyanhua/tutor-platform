}
.tutor-meta {
  flex: 1;
  margin-left: 20rpx;
}
.tutor-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1b1c;
}
.tutor-tags {
  display: flex;
    flex-direction: row;
  margin-top: 10rpx;
}
.tag {
  font-size: 22rpx;

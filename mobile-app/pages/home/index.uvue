<template>
  <scroll-view class="page" scroll-y="true" style="height: 700px;">
    <view v-if="role == 2" class="workbench">
      <view class="welcome">
        <text class="welcome-title">老师工作台</text>
      </view>
      <view class="quick-grid">
        <view class="quick-item" @click="goCalendar">
          <text class="quick-icon">📅</text>
          <text class="quick-label">授课日历</text>
        </view>
        <view class="quick-item" @click="goStudents">
          <text class="quick-icon">👥</text>
          <text class="quick-label">我的学生</text>
        </view>
        <view class="quick-item" @click="goOrders">
          <text class="quick-icon">📋</text>
          <text class="quick-label">收到的预约</text>
        </view>
        <view class="quick-item" @click="goEvals">
          <text class="quick-icon">⭐</text>
          <text class="quick-label">学生评价</text>
        </view>
        <view class="quick-item" @click="goIncome">
          <text class="quick-icon">💰</text>
          <text class="quick-label">收入统计</text>
        </view>
      </view>

      <!-- 今日课程 -->
      <view class="panel">
        <view class="panel-head">
          <text class="panel-title">📅 今日课程</text>
          <text class="panel-count">{{ todayLessons.length }} 节</text>
        </view>
        <text v-if="todayLessons.length == 0" class="panel-empty">今天没有课程安排</text>
        <view v-for="(l: UTSJSONObject, i: number) in todayLessons" :key="i" class="lesson-row">
          <text class="lesson-time">{{ l['timeSlot'] }}</text>
          <view class="lesson-info">
            <text class="lesson-name">{{ l['studentName'] }} · {{ l['subjectName'] }}</text>
            <text class="lesson-status">{{ statusLabel(l['status'] as number) }}</text>
          </view>
        </view>
      </view>

      <!-- 待处理预约 -->
      <view class="panel">
        <view class="panel-head">
          <text class="panel-title">⏳ 待处理预约</text>
          <text class="panel-count">{{ pendingOrders.length }} 条</text>
        </view>
        <text v-if="pendingOrders.length == 0" class="panel-empty">暂无待处理预约</text>
        <view v-for="(o: UTSJSONObject, i: number) in pendingOrders" :key="i" class="pending-row" @click="goOrders">
          <view class="pending-info">
            <text class="pending-name">{{ o['studentName'] }} · {{ o['subjectName'] }}</text>
            <text class="pending-date">{{ o['appointDate'] }} {{ o['timeSlot'] }}</text>
          </view>
          <text class="pending-arrow">›</text>
        </view>
      </view>
    </view>

    <block v-if="role != 2">
    <view class="quick-grid student-quick">
      <view class="quick-item" @click="goStudentCalendar">
        <text class="quick-icon">📅</text>
        <text class="quick-label">我的课程表</text>
      </view>
      <view class="quick-item" @click="goOrders">
        <text class="quick-icon">📋</text>
        <text class="quick-label">我的订单</text>
      </view>
      <view class="quick-item" @click="goFavorites">
        <text class="quick-icon">❤️</text>
        <text class="quick-label">我的收藏</text>
      </view>
    </view>
    <text class="page-title">找家教</text>
    <scroll-view class="filter" scroll-x>
      <view class="filter-inner">
        <text
          :class="['filter-item', subjectId == 0 ? 'active' : '']"
          @click="selectSubject(0)"
        >全部</text>
        <text
          v-for="(s: UTSJSONObject, i: number) in subjects"
          :key="i"
          :class="['filter-item', subjectId == (s['id'] as number) ? 'active' : '']"
          @click="selectSubject(s['id'] as number)"
        >{{ s['name'] }}</text>
      </view>
    </scroll-view>

    <view class="fav-toggle" @click="toggleFav">
      <text :class="['checkbox', onlyFav ? 'checkbox-on' : '']">{{ onlyFav ? '☑' : '☐' }}</text>
      <text class="fav-label">只看我的收藏</text>
    </view>

    <view class="rec-btn" @click="loadRecommend">
      <text class="rec-btn-text">🤖 智能推荐老师</text>
    </view>

    <view v-for="(t: UTSJSONObject, i: number) in list" :key="i" class="card tutor-card" @click="goDetail(t)">
      <view class="tutor-head">
        <image v-if="t['avatar'] != null && t['avatar'] != ''" class="avatar" :src="t['avatar']" mode="aspectFill" />
        <text v-else class="avatar avatar-text">{{ (t['tutorName'] as string).substring(0, 1) }}</text>
        <view class="tutor-meta">
          <text class="tutor-name">{{ t['tutorName'] }}</text>
          <view class="tutor-tags">
            <text class="tag tag-subject">{{ t['subjectName'] }}</text>
            <text class="tag">{{ t['grade'] }}</text>
          </view>
        </view>
      </view>
      <text class="introduce">{{ t['introduce'] }}</text>
      <view class="tutor-foot">
        <text class="price">¥{{ t['price'] }}/小时</text>
        <text class="rating">★ {{ t['rating'] }}</text>
      </view>
    </view>

    <text v-if="!loading && list.length == 0" class="empty">暂无符合条件的家教</text>
    </block>
  </scroll-view>
</template>

<script lang="uts">
import { pageTutors, recommendTutors } from '../../api/tutor'
import { listSubjects } from '../../api/subject'
import { listFavorites } from '../../api/favorite'
import { pageOrders } from '../../api/order'
import { getToken, getUser } from '../../utils/storage'

export default {
  data() {
    return {
      list: [] as UTSJSONObject[],
      subjects: [] as UTSJSONObject[],
      subjectId: 0,
      loading: false,
      onlyFav: false,
      role: 0,
      allOrders: [] as UTSJSONObject[]
    }
  },
  computed: {
    todayStr(): string {
      const d = new Date()
      const m = (d.getMonth() + 1) < 10 ? '0' + (d.getMonth() + 1) : '' + (d.getMonth() + 1)
      const dd = d.getDate() < 10 ? '0' + d.getDate() : '' + d.getDate()
      return d.getFullYear() + '-' + m + '-' + dd
    },
    todayLessons(): UTSJSONObject[] {
      const result: UTSJSONObject[] = []
      const today = this.todayStr
      for (let i = 0; i < this.allOrders.length; i++) {
        const o = this.allOrders[i]
        const st = o['status'] as number
        if (o['appointDate'] == today && (st == 1 || st == 2 || st == 3)) {
          result.push(o)
        }
      }
      return result
    },
    pendingOrders(): UTSJSONObject[] {
      const result: UTSJSONObject[] = []
      for (let i = 0; i < this.allOrders.length; i++) {
        const o = this.allOrders[i]
        if ((o['status'] as number) == 0) {
          result.push(o)
          if (result.length >= 5) break
        }
      }
      return result
    }
  },
  onShow() {
    if (getToken() == '') {
      uni.reLaunch({ url: '/pages/auth/login' })
      return
    }
    const u = getUser()
    this.role = u != null ? (u['role'] as number) : 0
    if (this.role == 2) {
      this.loadOrders()
      return
    }
    this.load()
  },
  methods: {
    async loadOrders() {
      try {
        const params = new Map<string, any>()
        params.set('page', 1)
        params.set('size', 200)
        const res = await pageOrders(params)
        this.allOrders = res['records'] as UTSJSONObject[]
      } catch (e) {}
    },
    statusLabel(s: number): string {
      if (s == 1) return '已预约'
      if (s == 2) return '授课中'
      if (s == 3) return '已完成'
      return ''
    },
    async load() {
      this.loading = true
      try {
        if (this.onlyFav) {
          const res = await listFavorites()
          this.list = res['list'] as UTSJSONObject[]
        } else {
          const subRes = await listSubjects()
          this.subjects = subRes['list'] as UTSJSONObject[]
          const params = new Map<string, any>()
          params.set('page', 1)
          params.set('size', 20)
          if (this.subjectId != 0) {
            params.set('subjectId', this.subjectId)
          }
          const res = await pageTutors(params)
          this.list = res['records'] as UTSJSONObject[]
        }
      } catch (e) {
        uni.showToast({ title: '加载失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },
    toggleFav() {
      this.onlyFav = !this.onlyFav
      this.load()
    },
    async loadRecommend() {
      try {
        const res = await recommendTutors(this.subjectId, 3)
        this.list = res['list'] as UTSJSONObject[]
        this.onlyFav = false
        uni.showToast({ title: '已为您推荐老师', icon: 'none' })
      } catch (e) {
        uni.showToast({ title: '推荐失败', icon: 'none' })
      }
    },
    selectSubject(id: number) {
      this.subjectId = id
      this.load()
    },
    goDetail(t: UTSJSONObject) {
      uni.navigateTo({
        url: '/pages/tutor/detail?id=' + t['id']
      })
    },
    goCalendar() { uni.navigateTo({ url: '/pages/tutor/calendar' }) },
    goStudents() { uni.navigateTo({ url: '/pages/tutor/students' }) },
    goOrders() { uni.switchTab({ url: '/pages/order/list' }) },
    goEvals() { uni.navigateTo({ url: '/pages/tutor/evaluations' }) },
    goIncome() { uni.navigateTo({ url: '/pages/tutor/income' }) },
    goStudentCalendar() { uni.navigateTo({ url: '/pages/student/calendar' }) },
    goFavorites() { uni.navigateTo({ url: '/pages/favorite/list' }) }
  }
}
</script>


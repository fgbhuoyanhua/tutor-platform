<template>
  <scroll-view class="page" scroll-y="true" style="height: 700px;">
    <view class="card">
      <view class="row">
        <text class="label">原时间</text>
        <text class="value">{{ oldDate }} {{ oldSlot }}</text>
      </view>
      <view class="row">
        <text class="label">新日期</text>
        <picker mode="date" :start="today" @change="onDateChange">
          <view class="picker">{{ newDate || '请选择新日期' }}</view>
        </picker>
      </view>
      <view class="row">
        <text class="label">新时段</text>
        <picker :range="slots" @change="onSlotChange">
          <view class="picker">{{ newSlot || '请选择新时段' }}</view>
        </picker>
      </view>
    </view>
    <button class="submit" @click="submit">提交申请</button>
  </scroll-view>
</template>

<script lang="uts">
import { rescheduleRequest } from '../../api/order'
import { TIME_SLOTS } from '../../constants'

export default {
  data() {
    return {
      orderId: 0,
      oldDate: '',
      oldSlot: '',
      newDate: '',
      newSlot: '',
      slots: TIME_SLOTS as string[],
      today: ''
    }
  },
  onLoad(query: OnLoadOptions) {
    const oid = query['orderId']
    this.orderId = parseInt(oid != null ? oid.toString() : '0')
    const od = query['oldDate']
    this.oldDate = od != null ? od.toString() : ''
    const os = query['oldSlot']
    this.oldSlot = os != null ? decodeURIComponent(os.toString()).toString() : ''
    const d = new Date()
    const y = d.getFullYear()
    const m = (d.getMonth() + 1).toString().padStart(2, '0')
    const day = d.getDate().toString().padStart(2, '0')
    this.today = y + '-' + m + '-' + day
  },
  methods: {
    onDateChange(e: UTSJSONObject) {
      const detail = e['detail'] as UTSJSONObject | null
      const v = detail != null ? (detail['value'] as string | null) : null
      this.newDate = v != null ? v.toString() : ''
    },
    onSlotChange(e: UTSJSONObject) {
      const detail = e['detail'] as UTSJSONObject | null
      const v = detail != null ? (detail['value'] as string | null) : '0'
      const idx = parseInt(v != null ? v.toString() : '0')
      this.newSlot = this.slots[idx]
    },
    async submit() {
      if (this.newDate == '' || this.newSlot == '') {
        uni.showToast({ title: '请选择新日期和时段', icon: 'none' })
        return
      }
      try {
        await rescheduleRequest(this.orderId, this.newDate, this.newSlot)
        uni.showToast({ title: '已提交，等待老师处理', icon: 'success' })
        setTimeout(() => {
          uni.navigateBack()
        }, 800)
      } catch (e) {
        uni.showToast({ title: '提交失败', icon: 'none' })
      }
    }
  }
}
</script>

<style>
.page {
  flex: 1;
  background: #f5f7fa;
  padding: 20rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.row {
  display: flex;
    flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom-width: 1px;
  border-bottom-color: #f5f5f5;
}
.label {
  width: 140rpx;
  font-size: 26rpx;
  color: #909399;
}
.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.picker {
  flex: 1;
  font-size: 28rpx;
  color: #4f6ef7;
}
.submit {
  margin-top: 40rpx;
  background: #4f6ef7;
  color: #ffffff;
  font-size: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
}
</style>

<template>
  <scroll-view class="page" scroll-y="true" style="height: 700px;">
    <view v-if="isTutor" class="income-entry" @click="goIncome">
      <text class="income-entry-text">收入统计</text>
      <text class="income-entry-arrow">›</text>
    </view>

    <view v-for="(o: UTSJSONObject, i: number) in list" :key="i" class="card order-card">
      <view class="order-head">
        <text class="subject">{{ o['subjectName'] }}</text>
        <text class="status">{{ fmtStatus(o['status'] as number) }}</text>
      </view>
      <view class="order-body">
        <view class="row">
          <text class="label">{{ isTutor ? '学生' : '老师' }}</text>
          <text class="value">{{ isTutor ? o['studentName'] : o['tutorName'] }}</text>
        </view>
        <view class="row">
          <text class="label">时间</text>
          <text class="value">{{ o['appointDate'] }} {{ o['timeSlot'] }}</text>
        </view>
        <view class="row">
          <text class="label">金额</text>
          <text class="value price">¥{{ o['totalPrice'] }}</text>
        </view>
      </view>
      <view class="order-foot">
        <view v-if="isTutor && o['status'] == 0">
          <button class="btn-sm btn-success" @click="doAction(o, 'confirm')">接单</button>
          <button class="btn-sm btn-danger" @click="doAction(o, 'reject')">拒绝</button>
        </view>
        <view v-if="isTutor && o['status'] == 1">
          <button class="btn-sm btn-primary" @click="doAction(o, 'start')">开始授课</button>
          <button class="btn-sm btn-success" @click="doAction(o, 'rsAccept')">同意调课</button>
          <button class="btn-sm btn-warning" @click="doAction(o, 'rsReject')">拒绝调课</button>
        </view>
        <view v-if="!isTutor && o['status'] == 1">
          <button class="btn-sm btn-primary" @click="goReschedule(o)">申请调课</button>
        </view>
        <view v-if="!isTutor && o['status'] == 0">
          <button class="btn-sm btn-danger" @click="doAction(o, 'cancel')">取消预约</button>
        </view>
        <view v-if="!isTutor && o['status'] == 2">
          <button class="btn-sm btn-success" @click="doAction(o, 'finish')">确认完成</button>
        </view>
        <view v-if="!isTutor && o['status'] == 3 && evalTargetId != o['id']">
          <button class="btn-sm btn-primary" @click="openEval(o)">评价</button>
        </view>
      </view>

      <view v-if="evalTargetId == o['id']" class="eval-panel">
        <view class="eval-row">
          <text class="eval-label">评分</text>
          <view class="stars">
            <text
              v-for="(s: number, i: number) in starList"
              :key="i"
              :class="['star', s <= evalScore ? 'star-on' : '']"
              @click="evalScore = s"
            >★</text>
          </view>
        </view>
        <input
          class="eval-input"
          v-model="evalContent"
          placeholder="说说这次辅导体验（选填，500字内）"
          maxlength="500"
        />
        <view class="eval-actions">
          <button class="btn-sm btn-cancel" @click="closeEval">取消</button>
          <button class="btn-sm btn-success" @click="submitEval(o)">提交评价</button>
        </view>
      </view>
    </view>

    <text v-if="!loading && list.length == 0" class="empty">暂无订单</text>
  </scroll-view>
</template>

<script lang="uts">
import { pageOrders, confirmOrder, rejectOrder, cancelOrder, finishOrder, startOrder, rescheduleAccept, rescheduleReject } from '../../api/order'
import { submitEvaluation } from '../../api/evaluation'
import { orderStatusLabel } from '../../constants'
import { getUser } from '../../utils/storage'

export default {
  data() {
    return {
      list: [] as UTSJSONObject[],
      loading: false,
      isTutor: false,
      evalTargetId: -1,
      evalScore: 5,
      evalContent: '',
      starList: [1, 2, 3, 4, 5] as number[]
    }
  },
  onShow() {
    const user = getUser()
    if (user == null) {
      uni.reLaunch({ url: '/pages/auth/login' })
      return
    }
    this.isTutor = user!['role'] == 2
    this.load()
  },
  methods: {
    fmtStatus(status: number): string {
      return orderStatusLabel(status)
    },
    goIncome() {
      uni.navigateTo({ url: '/pages/tutor/income' })
    },
    goReschedule(o: UTSJSONObject) {
      uni.navigateTo({
        url: '/pages/order/reschedule?orderId=' + o['id'] + '&oldDate=' + o['appointDate'] + '&oldSlot=' + encodeURIComponent(o['timeSlot'] as string)
      })
    },
    openEval(o: UTSJSONObject) {
      this.evalTargetId = o['id'] as number
      this.evalScore = 5
      this.evalContent = ''
    },
    closeEval() {
      this.evalTargetId = -1
    },
    async submitEval(o: UTSJSONObject) {
      if (this.evalContent.length > 500) {
        uni.showToast({ title: '评价内容不能超过500字', icon: 'none' })
        return
      }
      try {
        const body = new UTSJSONObject()
        body.set('orderId', o['id'])
        body.set('score', this.evalScore)
        if (this.evalContent != '') {
          body.set('content', this.evalContent)
        }
        await submitEvaluation(body)
        uni.showToast({ title: '评价成功', icon: 'success' })
        this.closeEval()
        this.load()
      } catch (e) {
        uni.showToast({ title: '评价失败', icon: 'none' })
      }
    },
    async load() {
      this.loading = true
      try {
        const params = new Map<string, any>()
        params.set('page', 1)
        params.set('size', 20)
        const res = await pageOrders(params)
        this.list = res['records'] as UTSJSONObject[]
      } catch (e) {
        uni.showToast({ title: '加载失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },
    doAction(o: UTSJSONObject, action: string) {
      let title = '确认操作？'
      if (action == 'confirm') title = '确认接单？'
      else if (action == 'reject') title = '确认拒绝该预约？'
      else if (action == 'cancel') title = '确认取消该预约？'
      else if (action == 'finish') title = '确认已完成授课？'
      else if (action == 'start') title = '确认开始授课？'
      else if (action == 'rsAccept') title = '同意后订单时间将改为学生申请的新时间，确认？'
      else if (action == 'rsReject') title = '拒绝后仍按原时间上课，确认？'
      uni.showModal({
        title: '提示',
        content: title,
        success: (res) => {
          if (!res.confirm) return
          this.execAction(action, o['id'] as number)
        }
      })
    },
    async execAction(action: string, id: number) {
      try {
        if (action == 'confirm') await confirmOrder(id)
        else if (action == 'reject') await rejectOrder(id)
        else if (action == 'cancel') await cancelOrder(id)
        else if (action == 'finish') await finishOrder(id)
        else if (action == 'start') await startOrder(id)
        else if (action == 'rsAccept') await rescheduleAccept(id)
        else if (action == 'rsReject') await rescheduleReject(id)
        uni.showToast({ title: '操作成功', icon: 'success' })
        this.load()
      } catch (e) {
        uni.showToast({ title: '操作失败', icon: 'none' })
      }
    }
  }
}
</script>

<style>
.page {
  flex: 1;
  background: #f5f7fa;
}
.income-entry {
  display: flex;
    flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  margin: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
}
.income-entry-text {
  font-size: 28rpx;
  color: #1a1b1c;
}
.income-entry-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
}
.order-head {
  display: flex;
    flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.subject {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1b1c;
}
.status {
  font-size: 24rpx;
  color: #4f6ef7;
}
.order-body {
  margin-top: 16rpx;
}
.row {
  display: flex;
    flex-direction: row;
  padding: 8rpx 0;
}
.label {
  width: 120rpx;
  font-size: 26rpx;
  color: #909399;
}
.value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.price {
  color: #f56c6c;
  font-weight: 600;
}
.order-foot {
  display: flex;
    flex-direction: row;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.btn-sm {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  height: 60rpx;
  line-height: 60rpx;
}
.btn-primary {
  background: #4f6ef7;
  color: #ffffff;
}
.btn-success {
  background: #67c23a;
  color: #ffffff;
}
.btn-danger {
  background: #f56c6c;
  color: #ffffff;
}
.btn-warning {
  background: #e6a23c;
  color: #ffffff;
}
.btn-cancel {
  background: #f0f2f5;
  color: #606266;
}
.eval-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top-width: 1px;
  border-top-color: #f0f0f0;
}
.eval-row {
  display: flex;
    flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}
.eval-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-right: 20rpx;
}
.stars {
  display: flex;
    flex-direction: row;
}
.star {
  font-size: 36rpx;
  color: #dcdfe6;
  margin-right: 8rpx;
}
.star-on {
  color: #e6a23c;
}
.eval-input {
  background: #f5f7fa;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.eval-actions {
  display: flex;
    flex-direction: row;
  justify-content: flex-end;
}
.empty {
  text-align: center;
  color: #909399;
  padding: 120rpx 0;
  font-size: 28rpx;
}
</style>

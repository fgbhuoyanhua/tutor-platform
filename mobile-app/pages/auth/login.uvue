<template>
  <scroll-view class="page" scroll-y="true" style="height: 700px;">
    <view class="brand">
      <text class="brand-title">家教预约平台</text>
      <text class="brand-sub">大学生家教服务预约</text>
    </view>
    <view class="form">
      <input class="input" v-model="username" placeholder="用户名" />
      <input class="input" v-model="password" password placeholder="密码" />
      <button class="btn-login" :loading="loading" @click="doLogin">登录</button>
      <view class="links">
        <text class="link" @click="goRegister">没有账号？去注册</text>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { login } from '../../api/auth'
import { setToken, setUser } from '../../utils/storage'

export default {
  data() {
    return {
      username: '',
      password: '',
      loading: false
    }
  },
  methods: {
    async doLogin() {
      if (this.username.trim() == '' || this.password == '') {
        uni.showToast({ title: '请输入用户名和密码', icon: 'none' })
        return
      }
      this.loading = true
      try {
        const res = await login(this.username.trim(), this.password)
        const token = res['token'] as string
        setToken(token)
        setUser(res)
        uni.showToast({ title: '登录成功', icon: 'success' })
        setTimeout(() => {
          uni.switchTab({ url: '/pages/home/index' })
        }, 500)
      } catch (e) {
        uni.showModal({ title: '登录失败', content: '' + e, showCancel: false })
      } finally {
        this.loading = false
      }
    },
    goRegister() {
      uni.navigateTo({ url: '/pages/auth/register' })
    }
  }
}
</script>

<style>
.page {
  flex: 1;
  background: #f5f7fa;
  padding: 80rpx 40rpx;
}
.brand {
  margin-bottom: 60rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1b1c;
}
.brand-sub {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}
.input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.btn-login {
  background: #4f6ef7;
  color: #ffffff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
}
.links {
  margin-top: 32rpx;
}
.link {
  font-size: 26rpx;
  color: #4f6ef7;
}
</style>

  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
}
.form-sub {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  margin-bottom: 36rpx;
}
.input {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e2e8f0;
}
.ph {
  color: #94a3b8;
  font-size: 28rpx;
}
.role-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}
.role-item {
  flex: 1;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-right: 16rpx;
  align-items: center;
}
.role-item:last-child {
  margin-right: 0;
}
.role-active {
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
}
.role-text {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 600;
}
.role-text-active {
  color: #ffffff;
}
.btn-register {
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  border: none;
  padding: 0;
  margin-top: 32rpx;
}
.links {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}
.link-tip {
  font-size: 26rpx;
  color: #64748b;
}

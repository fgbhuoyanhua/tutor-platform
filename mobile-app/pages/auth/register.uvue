<template>
  <scroll-view class="page" scroll-y="true" style="height: 1400px;">
    <view class="brand">
      <view class="brand-row">
        <text class="brand-name">青蓝</text>
        <view class="brand-line"></view>
        <text class="brand-sub">家教平台</text>
      </view>
      <text class="brand-title">加入青蓝</text>
      <text class="brand-slogan">开启知识传递之旅</text>
    </view>

    <view class="form-card">
      <text class="form-title">创建账号</text>
      <text class="form-sub">注册后选择学生或老师身份</text>

      <input class="input" v-model="username" placeholder="用户名（登录用）" placeholder-class="ph" />
      <input class="input" v-model="realName" placeholder="真实姓名" placeholder-class="ph" />
      <input class="input" v-model="phone" placeholder="手机号" placeholder-class="ph" type="number" />
      <input class="input" v-model="password" password placeholder="密码（至少6位）" placeholder-class="ph" />
      <input class="input" v-model="confirmPwd" password placeholder="确认密码" placeholder-class="ph" confirm-type="send" @confirm="doRegister" />

      <view class="role-row">
        <view :class="['role-item', role == 1 ? 'role-active' : '']" @click="selectRole(1)">
          <text :class="['role-text', role == 1 ? 'role-text-active' : '']">我是学生</text>
        </view>
        <view :class="['role-item', role == 2 ? 'role-active' : '']" @click="selectRole(2)">
          <text :class="['role-text', role == 2 ? 'role-text-active' : '']">我是老师</text>
        </view>
      </view>

      <button class="btn-register" :loading="loading" @click="doRegister">注 册</button>
      <view class="links">
        <text class="link-tip">已有账号？</text>
        <text class="link" @click="goLogin">去登录</text>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { register } from '../../api/auth'

export default {
  data() {
    return {
      username: '',
      realName: '',
      phone: '',
      password: '',
      confirmPwd: '',
      role: 1,
      loading: false
    }
  },
  methods: {
    selectRole(r: number) {
      this.role = r
    },
    async doRegister() {
      if (this.loading) return
      if (this.username.trim() == '') {
        uni.showToast({ title: '请输入用户名', icon: 'none' })
        return
      }
      if (this.realName.trim() == '') {
        uni.showToast({ title: '请输入真实姓名', icon: 'none' })
        return
      }
      if (this.phone.trim() == '') {
        uni.showToast({ title: '请输入手机号', icon: 'none' })
        return
      }
      if (this.password.length < 6) {
        uni.showToast({ title: '密码至少6位', icon: 'none' })
        return
      }
      if (this.password != this.confirmPwd) {
        uni.showToast({ title: '两次密码不一致', icon: 'none' })
        return
      }
      this.loading = true
      try {
        await register(this.username.trim(), this.password, this.role, this.realName.trim(), this.phone.trim())
        uni.showToast({ title: '注册成功，请登录', icon: 'success' })
        setTimeout(() => {
          uni.navigateBack()
        }, 800)
      } catch (e) {
        uni.showToast({ title: '注册失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },
    goLogin() {
      uni.navigateBack()
    }
  }
}
</script>


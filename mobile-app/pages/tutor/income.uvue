<template>
  <!-- 实验1：外层 flex 容器撑满 + scroll-view flex:1 + height:1px（社区方案） -->
  <scroll-view class="page" scroll-y="true" style="flex: 1; height: 1000px;">
    <!-- 2026-10-26：padding 不能加在 scroll-view 本身（会导致无法滚动），
         改由内层 view 承担内边距 -->
    <view class="page-inner">
    <!-- 统计卡片 2x2 -->
    <view class="stat-grid">
      <view class="stat-card">
        <text class="stat-num">¥{{ dash != null && dash!['totalIncome'] != null ? (dash!['totalIncome'] as number).toFixed(2) : '0.00' }}</text>
        <text class="stat-label">累计收入</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{ dash != null ? dash!['totalOrders'] : 0 }}</text>
        <text class="stat-label">累计订单</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{ dash != null ? dash!['completedOrders'] : 0 }}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{ dash != null ? dash!['pendingOrders'] : 0 }}</text>
        <text class="stat-label">待确认</text>
      </view>
    </view>

    <!-- 收入趋势 -->
    <view class="card">
      <text class="card-title">近6个月收入趋势</text>
      <view v-if="trend.length == 0" class="empty">暂无数据</view>
      <view v-else class="bar-chart">
        <view v-for="(item: UTSJSONObject, i: number) in trend" :key="i" class="bar-col">
          <text class="bar-val">¥{{ item['totalIncome'] != null ? (item['totalIncome'] as number).toFixed(0) : '0' }}</text>
          <view class="bar-wrap">
            <view class="bar" :style="{ height: barH(item['totalIncome'] as number) }"></view>
          </view>
          <text class="bar-lbl">{{ item['month'] as string }}</text>
        </view>
      </view>
    </view>

    <!-- 订单状态分布 -->
    <view class="card">
      <text class="card-title">订单状态分布</text>
      <view v-if="statusList.length == 0" class="empty">暂无数据</view>
      <view v-else>
        <view v-for="(s: UTSJSONObject, i: number) in statusList" :key="i" class="status-row">
          <text class="status-name">{{ s['statusName'] as string }}</text>
          <view class="status-bar-wrap">
            <view class="status-bar" :style="{ width: statusW(s['count'] as number), background: statusColor(i) }"></view>
          </view>
          <text class="status-count">{{ s['count'] as number }}</text>
        </view>
      </view>
    </view>

    <!-- 学科收入分布 -->
    <view class="card">
      <text class="card-title">学科收入分布</text>
      <view v-if="subjectList.length == 0" class="empty">暂无数据</view>
      <view v-else class="bar-chart">
        <view v-for="(s: UTSJSONObject, i: number) in subjectList" :key="i" class="bar-col">
          <text class="bar-val">¥{{ s['income'] != null ? (s['income'] as number).toFixed(0) : '0' }}</text>
          <view class="bar-wrap">
            <view class="bar bar-subject" :style="{ height: barH(s['income'] as number) }"></view>
          </view>
          <text class="bar-lbl">{{ s['subjectName'] as string }}</text>
        </view>
      </view>
    </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { getTutorDashboard } from '../../api/tutor'

export default {
  data() {
    return {
      dash: null as UTSJSONObject | null,
      trend: [] as UTSJSONObject[],
      statusList: [] as UTSJSONObject[],
      subjectList: [] as UTSJSONObject[],
      maxVal: 1 as number,
      maxStatus: 1 as number
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    async load() {
      try {
        const res = await getTutorDashboard()
        this.dash = res
        this.trend = res['incomeTrend'] as UTSJSONObject[]
        this.statusList = res['statusDistribution'] as UTSJSONObject[]
        this.subjectList = res['subjectIncome'] as UTSJSONObject[]
        let mx = 1
        for (let i = 0; i < this.trend.length; i++) {
          const v = this.trend[i]['totalIncome'] as number
          if (v > mx) mx = v
        }
        for (let i = 0; i < this.subjectList.length; i++) {
          const v = this.subjectList[i]['income'] as number
          if (v > mx) mx = v
        }
        this.maxVal = mx
        let ms = 1
        for (let i = 0; i < this.statusList.length; i++) {
          const c = this.statusList[i]['count'] as number
          if (c > ms) ms = c
        }
        this.maxStatus = ms
      } catch (e) {
        uni.showToast({ title: '加载失败', icon: 'none' })
      }
    },
    barH(v: number): string {
      // NaN / null 兜底，避免柱状图高度算出 "NaNpx"
      const val = (v == null || isNaN(v)) ? 0 : v
      const mx = this.maxVal > 0 ? this.maxVal : 1
      const h = Math.max(4, (val / mx) * 120)
      return '' + h + 'px'
    },
    statusW(c: number): string {
      const val = (c == null || isNaN(c)) ? 0 : c
      const ms = this.maxStatus > 0 ? this.maxStatus : 1
      const w = Math.max(2, (val / ms) * 100)
      return '' + w + '%'
    },
    statusColor(i: number): string {
      const colors = ['#3b82f6', '#06b6d4', '#8b5cf6', '#f59e0b', '#10b981', '#ef4444']
      return colors[i % colors.length]
    }
  }
}
</script>

<style>
.page {
  background: #f5f7fa;
  /* ⚠️ 不要在这里加 padding-bottom：scroll-view 上的 padding 不参与内容高度，
     底部留白放内层 .page-inner（见下）。 */
}
.page-inner {
  padding: 20rpx;
  /* 底部留白放内层，绕开 scroll-view 自身 padding 的坑 */
  padding-bottom: 60rpx;
}
.stat-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  /* 不用 gap（uni-app x 不支持，仅 warning 且可能不生效），用 margin 实现 2x2 间距 */
}
.stat-card {
  /* 48% + 左右各 1% 外边距 = 100%，形成两列；需要 box-sizing 保证 padding 不撑破 */
  width: 48%;
  margin-left: 1%;
  margin-right: 1%;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2d3d;
}
.stat-label {
  font-size: 24rpx;
  color: #909399;
  margin-top: 8rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 20rpx;
}
.empty {
  text-align: center;
  color: #909399;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.bar-chart {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  /* 不用 gap，用每个 bar-col 的左右 margin 做出间距 */
  /* ⚠️ 不要在这里写固定 height（如 200px）。
     2026-10-26 实测：去掉它并不能让本页滚动（已排除为根因），
     但「父容器固定高度 + 子元素内联 :style 高度」这种组合没有收益，
     高度交给 .bar-col 自己撑更稳。 */
  padding-top: 10px;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 不用 height:100%（uni-app x 不支持），父级已有固定 200px，这里用固定高度 */
  height: 190px;
  margin-left: 6rpx;
  margin-right: 6rpx;
}
.bar-val {
  font-size: 20rpx;
  color: #606266;
  margin-bottom: 6rpx;
}
.bar-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  width: 100%;
  justify-content: center;
}
.bar {
  width: 40rpx;
  background: linear-gradient(180deg, #3b82f6, #06b6d4);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4px;
}
.bar-subject {
  background: linear-gradient(180deg, #06b6d4, #3b82f6);
}
.bar-lbl {
  font-size: 20rpx;
  color: #909399;
  margin-top: 8rpx;
}
.status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}
.status-name {
  width: 120rpx;
  font-size: 24rpx;
  color: #606266;
}
.status-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.status-bar {
  /* 不用 height:100%（uni-app x 不支持），父级 status-bar-wrap 固定 16rpx，这里写同值 */
  height: 16rpx;
  border-radius: 8rpx;
}
.status-count {
  width: 60rpx;
  font-size: 24rpx;
  color: #1f2d3d;
  text-align: right;
}
</style>

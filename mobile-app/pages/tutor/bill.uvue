}
.item-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.item-no {
  font-size: 22rpx;
  color: #9ca3af;
}
.item-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #e55;
}
</style>

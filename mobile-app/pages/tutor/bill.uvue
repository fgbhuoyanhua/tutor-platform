  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
  margin-top: 4rpx;
}
.empty {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  padding-top: 40rpx; padding-bottom: 40rpx;
}
.bill-item {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  border-bottom-width: 1rpx;
  border-bottom-color: #f3f4f6;
  border-bottom-style: solid;
}
.item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.item-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1b1c;
}
.item-status {
  font-size: 22rpx;
  padding-top: 4rpx; padding-bottom: 4rpx;
  padding-left: 12rpx; padding-right: 12rpx;
  border-radius: 8rpx;
}
.status-done { background: #ecfdf5; color: #059669; }
.status-wait { background: #fff7e6; color: #b8860b; }
.status-run { background: #eef2ff; color: #4f6ef7; }
.status-off { background: #f3f4f6; color: #9ca3af; }
.item-mid {
  display: flex;
  flex-direction: row;
